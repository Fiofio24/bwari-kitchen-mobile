{
  "expo": {
    "name": "Bwari Kitchen",
    "slug": "bwari-kitchen",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/BK_logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#d30000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiowebin.bwarikitchen",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/BK_logo.png",
        "dark": "./assets/BK_logo_dark.png",
        "tinted": "./assets/BK_logo_monochrome.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/BK_logo.png",
        "backgroundColor": "#d30000",
        "monochromeImage": "./assets/BK_logo_monochrome.png"
      },
      "package": "com.fiowebin.bwarikitchen",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/BK_logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bwari Kitchen to use your location to find your delivery address."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "bwarikitchen",
    "owner": "fiofio24",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b43549ec-ac0e-47ad-b457-19de98b6237f"
      }
    }
  }
}