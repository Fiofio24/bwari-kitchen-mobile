{
  "expo": {
    "name": "Bwari Kitchen",
    "slug": "bwari-kitchen",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/BK_logo12-r.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#d30000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiotecz.bwarikitchen"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/BK_logo.png",
        "backgroundColor": "#d30000"
      },
      "package": "com.fiotecz.bwarikitchen",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/BK_logo12-r.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bwari Kitchen to use your location to find your delivery address."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "bwarikitchen",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a131349a-4d98-4c7d-a2d3-96d830f948a6"
      }
    },
    "owner": "cybernaut"
  }
}
